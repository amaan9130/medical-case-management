{
	"info": {
		"_postman_id": "7f8b9e6a-5432-4e91-89d1-9f20e4b85c10",
		"name": "Jajal Medical Case Management API",
		"description": "Complete REST API collection for Jajal Medical Case Management web application. Includes authentication (Sanctum bearer tokens), case CRUD, role authorization checks, and validation error scenarios.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000/api",
			"type": "string"
		},
		{
			"key": "admin_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "viewer_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "created_case_id",
			"value": "1",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "1. Login as Admin",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.success && jsonData.data && jsonData.data.token) {",
									"    pm.collectionVariables.set('admin_token', jsonData.data.token);",
									"    console.log('Saved admin_token: ' + jsonData.data.token);",
									"}",
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@jajalmedical.com\",\n    \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/login",
							"host": ["{{base_url}}"],
							"path": ["login"]
						}
					}
				},
				{
					"name": "2. Login as Viewer",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.success && jsonData.data && jsonData.data.token) {",
									"    pm.collectionVariables.set('viewer_token', jsonData.data.token);",
									"    console.log('Saved viewer_token: ' + jsonData.data.token);",
									"}",
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"viewer@jajalmedical.com\",\n    \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/login",
							"host": ["{{base_url}}"],
							"path": ["login"]
						}
					}
				},
				{
					"name": "3. Logout (Revoke Token)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{admin_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/logout",
							"host": ["{{base_url}}"],
							"path": ["logout"]
						}
					}
				}
			]
		},
		{
			"name": "Cases Operations",
			"item": [
				{
					"name": "1. List Cases (Paginated)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{admin_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/cases?page=1&per_page=10&status=Planning",
							"host": ["{{base_url}}"],
							"path": ["cases"],
							"query": [
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "per_page",
									"value": "10"
								},
								{
									"key": "status",
									"value": "Planning"
								}
							]
						}
					}
				},
				{
					"name": "2. Create Case (Admin Only - Status 201)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.success && jsonData.data && jsonData.data.id) {",
									"    pm.collectionVariables.set('created_case_id', jsonData.data.id);",
									"}",
									"pm.test('Status code is 201', function () {",
									"    pm.response.to.have.status(201);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{admin_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"case_number\": \"CASE-API-9901\",\n    \"patient_reference\": \"PAT-7701\",\n    \"surgeon_name\": \"Dr. Marcus Thorne, FRCS\",\n    \"implant_type\": \"Acetabular Hip Revision Cup\",\n    \"status\": \"Planning\",\n    \"priority\": \"High\",\n    \"surgery_date\": \"2026-11-20\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/cases",
							"host": ["{{base_url}}"],
							"path": ["cases"]
						}
					}
				},
				{
					"name": "3. Get Case By ID (Admin & Viewer - Status 200)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{viewer_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/cases/{{created_case_id}}",
							"host": ["{{base_url}}"],
							"path": ["cases", "{{created_case_id}}"]
						}
					}
				},
				{
					"name": "4. Update Case (Admin Only - Status 200)",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{admin_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"case_number\": \"CASE-API-9901\",\n    \"patient_reference\": \"PAT-7701\",\n    \"surgeon_name\": \"Dr. Marcus Thorne, FRCS\",\n    \"implant_type\": \"Acetabular Hip Revision Cup\",\n    \"status\": \"Approved\",\n    \"priority\": \"High\",\n    \"surgery_date\": \"2026-11-22\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/cases/{{created_case_id}}",
							"host": ["{{base_url}}"],
							"path": ["cases", "{{created_case_id}}"]
						}
					}
				},
				{
					"name": "5. Delete Case (Admin Only - Status 200)",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{admin_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/cases/{{created_case_id}}",
							"host": ["{{base_url}}"],
							"path": ["cases", "{{created_case_id}}"]
						}
					}
				}
			]
		},
		{
			"name": "Authorization & Validation Negative Tests",
			"item": [
				{
					"name": "Viewer Deleting Case (Expects 403 Forbidden)",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{viewer_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/cases/1",
							"host": ["{{base_url}}"],
							"path": ["cases", "1"]
						}
					}
				},
				{
					"name": "Duplicate Case Number (Expects 422 Unprocessable)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{admin_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"case_number\": \"CASE-1001\",\n    \"patient_reference\": \"PAT-DUPL\",\n    \"surgeon_name\": \"Dr. Jenkins\",\n    \"implant_type\": \"Cranial Plate\",\n    \"status\": \"Planning\",\n    \"priority\": \"High\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/cases",
							"host": ["{{base_url}}"],
							"path": ["cases"]
						}
					}
				},
				{
					"name": "Unauthenticated Access (Expects 401 Unauthorized)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/cases",
							"host": ["{{base_url}}"],
							"path": ["cases"]
						}
					}
				}
			]
		}
	]
}
